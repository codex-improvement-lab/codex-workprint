* text=auto eol=lf whitespace=-blank-at-eof
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.svg text eol=lf
*.sha256 text eol=lf
*.png binary
*.jpg binary
*.zip binary

# Preserve the pinned upstream font license, including its original whitespace.
assets/fonts/OFL-1.1.txt -text -whitespace
# Retain historical machine-log bytes across Git checkouts.
docs/evidence/windows/*.txt -text whitespace=cr-at-eol,-blank-at-eof
